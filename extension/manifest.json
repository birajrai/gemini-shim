{
  "manifest_version": 3,
  "name": "Gemini Shim Session Sync",
  "version": "1.0.0",
  "description": "Exports Gemini session cookies, XSRF tokens, and build metadata for gemini-shim & Cloudflare Workers.",
  "icons": {
    "128": "logo.svg"
  },
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*"
  ],
  "action": {
    "default_title": "Gemini Shim Session Sync",
    "default_popup": "popup.html",
    "default_icon": "logo.svg"
  }
}
